# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# Groq AI (replaces Gemini)
GROQ_API_KEY=your_groq_api_key_here
# Model – llama-3.3-70b-versatile supports tool/function calling
GROQ_MODEL=llama-3.3-70b-versatile

# App Security
SECRET_KEY=your_very_long_random_secret_key_here_at_least_32_chars

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173

# Pub/Sub Topic (for Gmail push notifications)
PUBSUB_TOPIC=projects/your_project_id/topics/gmail-notifications
PUBSUB_SUBSCRIPTION=projects/your_project_id/subscriptions/gmail-sub

# Environment
ENVIRONMENT=development
